{
  "name": "ff-draft-optimizer",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npx playwright test",
    "mapper": "tsx scripts/sleeper-map.ts",
    "fp-map": "npm run mapper -- fantasypros_id fp",
    "ds-map": "npm run mapper -- draft_sharks_id ds",
    "dk-map": "npm run mapper -- draft_kings_id dk",
    "fg-map": "npm run mapper -- footballguys_id fg",
    "ffpc-map": "npm run mapper -- ffpc_id ffpc",
    "flock-map": "npm run mapper -- flock_fantasy_id flock",
    "add-ds": "tsx scripts/add-draftsharks-mappings.ts",
    "add-dk": "tsx scripts/add-draftkings-mappings.ts",
    "add-ffpc": "tsx scripts/add-ffpc-mappings.ts",
    "add-flock": "tsx scripts/add-flockfantasy-mappings.ts",
    "update-csv": "npm run add-ds && npm run add-dk && npm run add-ffpc && npm run add-flock"
  },
  "dependencies": {
    "@nuxt/icon": "^2.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "daisyui": "^5.6.7",
    "fast-xml-parser": "^5.9.3",
    "node-html-parser": "^8.0.3",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.82",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/papaparse": "^5.5.2",
    "papaparse": "^5.5.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5"
  }
}
